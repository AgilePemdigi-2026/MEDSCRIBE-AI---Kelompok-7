APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================================
# MAIL CONFIGURATION (Transactional OTP & Notifications)
# =========================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailprovider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="MedScribe AI"
MAIL_REPLY_TO_ADDRESS="support@yourdomain.com"
MAIL_REPLY_TO_NAME="MedScribe AI Support"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Temporary test accounts. Keep disabled in production unless explicitly needed.
SEED_DUMMY_ACCOUNTS=false
DUMMY_ACCOUNT_PASSWORD=
DUMMY_DOKTER_EMAIL=dummy.dokter@medscribe.id
DUMMY_PERAWAT_EMAIL=dummy.perawat@medscribe.id

# MedScribe local audio pipeline
MEDSCRIBE_AUDIO_DISK=local
MEDSCRIBE_AUDIO_MAX_SIZE_KB=102400
MEDSCRIBE_AUDIO_MAX_DURATION_SECONDS=3600
MEDSCRIBE_FFPROBE_PATH=ffprobe
MEDSCRIBE_AUDIO_RETENTION_HOURS=24
MEDSCRIBE_STT_URL=http://127.0.0.1:8765
MEDSCRIBE_STT_API_TOKEN=
MEDSCRIBE_STT_MODEL=openai/whisper-small
MEDSCRIBE_STT_DEVICE=auto
MEDSCRIBE_STT_DTYPE=auto
MEDSCRIBE_STT_LANGUAGE=indonesian
MEDSCRIBE_STT_BEAM_SIZE=5
MEDSCRIBE_STT_TIMEOUT_SECONDS=7200
MEDSCRIBE_DIARIZATION_ENABLED=false
HF_TOKEN=

# Set to openrouter only after configuring the key. No paid fallback is used.
MEDSCRIBE_SOAP_DRIVER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_VERIFY_SSL=true
